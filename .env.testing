# Dùng riêng cho `php artisan test` / PHPUnit — Laravel tự nạp file này khi
# APP_ENV=testing (đã set sẵn trong phpunit.xml), ưu tiên hơn `.env`.
#
# MỤC ĐÍCH: cách ly hoàn toàn DB test khỏi DB dev (MySQL warehouse_qlbx_sys).
# Test Inventory (ReceiveStockTest, v.v.) dùng RefreshDatabase — nếu không có
# file này, test sẽ chạy vào DB_CONNECTION/DB_DATABASE của .env dev và
# DROP + MIGRATE lại toàn bộ schema, XOÁ SẠCH data dev mỗi lần chạy test.
#
# KHÔNG commit giá trị nhạy cảm ở file này lên git nếu .gitignore chưa chặn
# .env.testing — kiểm tra lại .gitignore trước khi commit.

APP_ENV=testing
APP_KEY=base64:oJbY347pdkFZieg2oS4YkNSrPwEAm3LabCe0P5sXVTg=
